<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/positive_032dp">

    <!-- Decorative: the title below carries the meaning for screen readers. -->
    <TextView
        android:id="@+id/introImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_onboarding_circle"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textSize="88sp"
        tools:text="📚" />

    <TextView
        android:id="@+id/introTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/positive_040dp"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:maxWidth="400dp"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="?attr/colorOnSurface"
        tools:targetApi="28"
        tools:text="@string/onboardingTitle1" />

    <TextView
        android:id="@+id/introDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/positive_012dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:maxWidth="400dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="@string/onboardingBody1" />

</LinearLayout>
