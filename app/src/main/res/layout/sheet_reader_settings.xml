<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/positive_024dp"
    android:paddingBottom="@dimen/positive_032dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/readingSettingsText"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        style="@style/Widget.BMF.SettingsLabel"
        android:text="@string/textSizeText"
        app:drawableStartCompat="@drawable/ic_text_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fontSmallerButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/textSizeDecrease"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="A"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.slider.Slider
            android:id="@+id/fontSizeSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/textSizeText"
            android:stepSize="1"
            app:tickVisible="false"
            android:valueFrom="14"
            android:valueTo="30" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fontLargerButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/textSizeIncrease"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="A"
            android:textSize="22sp"
            tools:ignore="HardcodedText" />

    </LinearLayout>

    <TextView
        style="@style/Widget.BMF.SettingsLabel"
        android:text="@string/pageColorText"
        app:drawableStartCompat="@drawable/ic_palette" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/pageThemeToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/pagePaperButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/pagePaperText" />

        <Button
            android:id="@+id/pageSepiaButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/pageSepiaText" />

        <Button
            android:id="@+id/pageNightButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/pageNightText" />

    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
