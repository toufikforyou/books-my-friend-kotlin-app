<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bookRowItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="@dimen/positive_020dp"
    android:paddingVertical="@dimen/positive_010dp">

    <com.sopnolikhi.booksmyfriend.design.ui.custom.BookCoverView
        android:id="@+id/bookCover"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/bookTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/positive_016dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/bookCover"
        app:layout_constraintTop_toTopOf="@id/bookCover"
        tools:text="The Adventures of Sherlock Holmes" />

    <TextView
        android:id="@+id/bookAuthor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/bookTitle"
        app:layout_constraintTop_toBottomOf="@id/bookTitle"
        tools:text="Arthur Conan Doyle" />

    <TextView
        android:id="@+id/bookMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/positive_006dp"
        android:drawablePadding="@dimen/positive_004dp"
        android:gravity="center_vertical"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:drawableStartCompat="@drawable/ic_star"
        app:drawableTint="?attr/colorTertiary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/bookTitle"
        app:layout_constraintTop_toBottomOf="@id/bookAuthor"
        tools:text="4.8 · Mystery · 3 min read" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/bookProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/positive_010dp"
        android:layout_marginEnd="@dimen/positive_012dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/bookProgressText"
        app:layout_constraintStart_toStartOf="@id/bookTitle"
        app:layout_constraintTop_toBottomOf="@id/bookMeta"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp"
        tools:progress="40"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/bookProgressText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/bookProgress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/bookProgress"
        tools:text="40% read"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
